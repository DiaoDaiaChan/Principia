// FlightPlanShootingOptimizer.compute - Massively Parallel GPGPU Flight Plan Shooting Optimizer
// Dispatches 16,384 candidate maneuvers concurrently to evaluate trajectories and extract global minimum cost solution.

#pragma kernel GenerateCandidateGrid
#pragma kernel EvaluateTrajectoryBundle
#pragma kernel ParallelReduceOptimalBurn
#pragma kernel ParallelReduceOptimalBurnFinal

#include "DoubleSingle.hlsl"

#define GROUP_SIZE 256
#define TOTAL_CANDIDATES 16384

struct CandidateBurnParameters {
    float delta_t;
    float delta_v_tangent;
    float delta_v_normal;
    float delta_v_binormal;
};

struct CandidateBurnEvaluation {
    uint candidate_index;
    float periapsis_distance;
    float target_relative_speed;
    float cost_metric;
    float delta_t;
    float delta_v_tangent;
    float delta_v_normal;
    float delta_v_binormal;
};

struct CelestialBodyState {
    float3 position;
    float gravitational_parameter; // GM
    float3 velocity;
    float padding;
};

cbuffer OptimizerConfig : register(b0) {
    float4 _BaseBurnTimes;          // x: base_t0, y: span_t, z: vessel_mass, w: thrust
    float4 _BaseDeltaV;             // x: base_dv_t, y: base_dv_n, z: base_dv_b, w: isp
    float4 _SpanDeltaV;             // x: span_dv_t, y: span_dv_n, z: span_dv_b, w: target_periapsis
    float4 _OptimizationWeights;    // x: w_dist, y: w_speed, z: w_delta_v, w: w_inclination
    float4 _InitialVesselPos;       // xyz: pos_m, w: initial_time
    float4 _InitialVesselVel;       // xyz: vel_m_s, w: step_size_s
    float4 _GridDimensions;         // x: dim_t, y: dim_vt, z: dim_vn, w: dim_vb
    uint _CelestialCount;
    uint _StepCount;
    uint _TargetCelestialIndex;
    uint _ReductionItemCount;
};

StructuredBuffer<CelestialBodyState> _CelestialBodies : register(t0);
RWStructuredBuffer<CandidateBurnParameters> _CandidateGrid : register(u0);
RWStructuredBuffer<CandidateBurnEvaluation> _Evaluations : register(u1);
RWStructuredBuffer<CandidateBurnEvaluation> _ReducedResults : register(u2);

groupshared CandidateBurnEvaluation s_shared_evals[GROUP_SIZE];

// Kernel 1: Generate 16,384-node 4D parameter grid around base maneuver
[numthreads(GROUP_SIZE, 1, 1)]
void GenerateCandidateGrid(uint3 id : SV_DispatchThreadID) {
    uint index = id.x;
    if (index >= TOTAL_CANDIDATES) return;

    // Decompose index into dynamic 4D parameter space
    uint dim_t  = _GridDimensions.x > 0.5f ? uint(_GridDimensions.x) : 16;
    uint dim_vt = _GridDimensions.y > 0.5f ? uint(_GridDimensions.y) : 16;
    uint dim_vn = _GridDimensions.z > 0.5f ? uint(_GridDimensions.z) : 8;
    uint dim_vb = _GridDimensions.w > 0.5f ? uint(_GridDimensions.w) : 8;

    uint idx_vb = index % dim_vb;
    uint rem1   = index / dim_vb;
    uint idx_vn = rem1 % dim_vn;
    uint rem2   = rem1 / dim_vn;
    uint idx_vt = rem2 % dim_vt;
    uint idx_t  = rem2 / dim_vt;

    float norm_t  = dim_t  > 1 ? (float(idx_t)  / float(dim_t  - 1)) * 2.0f - 1.0f : 0.0f;
    float norm_vt = dim_vt > 1 ? (float(idx_vt) / float(dim_vt - 1)) * 2.0f - 1.0f : 0.0f;
    float norm_vn = dim_vn > 1 ? (float(idx_vn) / float(dim_vn - 1)) * 2.0f - 1.0f : 0.0f;
    float norm_vb = dim_vb > 1 ? (float(idx_vb) / float(dim_vb - 1)) * 2.0f - 1.0f : 0.0f;

    CandidateBurnParameters params;
    params.delta_t            = norm_t  * _BaseBurnTimes.y;
    params.delta_v_tangent    = _BaseDeltaV.x + norm_vt * _SpanDeltaV.x;
    params.delta_v_normal     = _BaseDeltaV.y + norm_vn * _SpanDeltaV.y;
    params.delta_v_binormal   = _BaseDeltaV.z + norm_vb * _SpanDeltaV.z;

    _CandidateGrid[index] = params;
}

// Kernel 2: Evaluate trajectory forward propagation for all 16,384 candidates
[numthreads(GROUP_SIZE, 1, 1)]
void EvaluateTrajectoryBundle(uint3 id : SV_DispatchThreadID) {
    uint index = id.x;
    if (index >= TOTAL_CANDIDATES) return;

    CandidateBurnParameters params = _CandidateGrid[index];

    // Compute delta-v magnitude penalty
    float dv_sqr = params.delta_v_tangent * params.delta_v_tangent +
                   params.delta_v_normal * params.delta_v_normal +
                   params.delta_v_binormal * params.delta_v_binormal;
    float delta_v_mag = sqrt(dv_sqr);

    // Initial state setup with candidate perturbation using Double-Single precision
    ds_vec3 pos = ds_vec3_make(_InitialVesselPos.xyz);
    float3 burn_dv = float3(params.delta_v_tangent, params.delta_v_normal, params.delta_v_binormal);
    ds_vec3 vel = ds_vec3_make(_InitialVesselVel.xyz + burn_dv);

    float min_periapsis_dist = 1e30f;
    float min_periapsis_speed = 1e30f;
    ds_real dt = ds_make(_InitialVesselVel.w); // step size in seconds

    // Forward propagation using symplectic Velocity-Verlet with DoubleSingle precision and moving bodies
    [loop]
    for (uint step = 0; step < _StepCount; ++step) {
        ds_vec3 accel = ds_vec3_make(float3(0.0f, 0.0f, 0.0f));
        ds_real step_elapsed = ds_mul(dt, ds_make(float(step)));
        [loop]
        for (uint b = 0; b < _CelestialCount; ++b) {
            CelestialBodyState body = _CelestialBodies[b];
            ds_vec3 body_motion = ds_vec3_scale(ds_vec3_make(body.velocity), step_elapsed);
            ds_vec3 body_pos = ds_vec3_add(ds_vec3_make(body.position), body_motion);
            ds_vec3 r = ds_vec3_sub(body_pos, pos);
            ds_real r2 = ds_vec3_length_sqr(r);
            ds_real dist = ds_sqrt(r2);
            float dist_f = ds_to_float(dist);

            if (dist_f > 1.0f) {
                ds_real inv_r = ds_div(ds_make(1.0f), dist);
                ds_real inv_r3 = ds_mul(ds_mul(inv_r, inv_r), inv_r);
                ds_real gm = ds_make(body.gravitational_parameter);
                ds_real factor = ds_mul(gm, inv_r3);
                accel = ds_vec3_add(accel, ds_vec3_scale(r, factor));
            }

            // Track distance to target celestial body
            if (b == _TargetCelestialIndex) {
                if (dist_f < min_periapsis_dist) {
                    min_periapsis_dist = dist_f;
                    ds_vec3 rel_vel = ds_vec3_sub(vel, ds_vec3_make(body.velocity));
                    min_periapsis_speed = ds_to_float(ds_vec3_length(rel_vel));
                }
            }
        }

        // Symplectic step with DoubleSingle precision
        vel = ds_vec3_add(vel, ds_vec3_scale(accel, dt));
        pos = ds_vec3_add(pos, ds_vec3_scale(vel, dt));
    }

    // Cost metric calculation
    float target_r = _SpanDeltaV.w;
    float dist_diff = abs(min_periapsis_dist - target_r);
    float cost = _OptimizationWeights.x * dist_diff +
                 _OptimizationWeights.y * min_periapsis_speed +
                 _OptimizationWeights.z * delta_v_mag;

    CandidateBurnEvaluation eval_result;
    eval_result.candidate_index        = index;
    eval_result.periapsis_distance     = min_periapsis_dist;
    eval_result.target_relative_speed  = min_periapsis_speed;
    eval_result.cost_metric            = cost;
    eval_result.delta_t                = params.delta_t;
    eval_result.delta_v_tangent        = params.delta_v_tangent;
    eval_result.delta_v_normal         = params.delta_v_normal;
    eval_result.delta_v_binormal       = params.delta_v_binormal;

    _Evaluations[index] = eval_result;
}

// Kernel 3: Parallel Reduction in shared memory to extract global minimum
[numthreads(GROUP_SIZE, 1, 1)]
void ParallelReduceOptimalBurn(
    uint3 group_thread_id : SV_GroupThreadID,
    uint3 group_id : SV_GroupID,
    uint3 dispatch_thread_id : SV_DispatchThreadID) {
    uint tid = group_thread_id.x;
    uint global_idx = dispatch_thread_id.x;

    if (global_idx < _ReductionItemCount) {
        s_shared_evals[tid] = _Evaluations[global_idx];
    } else {
        CandidateBurnEvaluation inf_eval = (CandidateBurnEvaluation)0;
        inf_eval.cost_metric = 1e38f;
        s_shared_evals[tid] = inf_eval;
    }
    GroupMemoryBarrierWithGroupSync();

    // In-place reduction in shared memory
    for (uint stride = GROUP_SIZE / 2; stride > 0; stride >>= 1) {
        if (tid < stride) {
            if (s_shared_evals[tid + stride].cost_metric < s_shared_evals[tid].cost_metric) {
                s_shared_evals[tid] = s_shared_evals[tid + stride];
            }
        }
        GroupMemoryBarrierWithGroupSync();
    }

    if (tid == 0) {
        _ReducedResults[group_id.x] = s_shared_evals[0];
    }
}

// Kernel 4: Final Parallel Reduction of the 64 group minimums into a single global minimum
[numthreads(GROUP_SIZE, 1, 1)]
void ParallelReduceOptimalBurnFinal(
    uint3 group_thread_id : SV_GroupThreadID,
    uint3 group_id : SV_GroupID,
    uint3 dispatch_thread_id : SV_DispatchThreadID) {
    uint tid = group_thread_id.x;

    // Load from the 64 group minimums produced by Pass 1
    if (tid < 64) {
        s_shared_evals[tid] = _ReducedResults[tid];
    } else {
        CandidateBurnEvaluation inf_eval = (CandidateBurnEvaluation)0;
        inf_eval.cost_metric = 1e38f;
        s_shared_evals[tid] = inf_eval;
    }
    GroupMemoryBarrierWithGroupSync();

    // In-place reduction in shared memory
    for (uint stride = GROUP_SIZE / 2; stride > 0; stride >>= 1) {
        if (tid < stride) {
            if (s_shared_evals[tid + stride].cost_metric < s_shared_evals[tid].cost_metric) {
                s_shared_evals[tid] = s_shared_evals[tid + stride];
            }
        }
        GroupMemoryBarrierWithGroupSync();
    }

    if (tid == 0) {
        _ReducedResults[0] = s_shared_evals[0];
    }
}
