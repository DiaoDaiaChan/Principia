// EquipotentialMarchingCubes.compute - 3D Roche Lobe and Zero-Velocity Surface Extractor
// Evaluates Jacobi effective potential and extracts equipotential surfaces in GPGPU.

#pragma kernel EvaluateJacobiPotentialField

#define THREADS_X 8
#define THREADS_Y 8
#define THREADS_Z 8

struct CelestialBodySimple {
    float3 position;
    float gm;
};

cbuffer PotentialConfig : register(b0) {
    float3 _GridOrigin;
    float _GridVoxelSize;
    uint3 _GridDimensions;
    float _RotationAngularSpeed;
    float3 _RotationAxis;
    uint _CelestialCount;
    float _TargetJacobiConstant;
};

StructuredBuffer<CelestialBodySimple> _CelestialBodies : register(t0);
RWStructuredBuffer<float> _PotentialGrid : register(u0);

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void EvaluateJacobiPotentialField(uint3 id : SV_DispatchThreadID) {
    if (id.x >= _GridDimensions.x || id.y >= _GridDimensions.y || id.z >= _GridDimensions.z) return;

    float3 world_pos = _GridOrigin + float3(id) * _GridVoxelSize;

    // 1. Gravitational potential from massive bodies: - sum (GM_i / r_i)
    float phi_grav = 0.0f;
    for (uint b = 0; b < _CelestialCount; ++b) {
        CelestialBodySimple body = _CelestialBodies[b];
        float dist = length(world_pos - body.position) + 1.0f;
        phi_grav -= body.gm / dist;
    }

    // 2. Centrifugal potential in rotating frame: - 0.5 * |omega x r|^2
    float3 r_rot = world_pos;
    float3 omega_cross_r = cross(_RotationAxis * _RotationAngularSpeed, r_rot);
    float phi_centrifugal = -0.5f * dot(omega_cross_r, omega_cross_r);

    // Effective potential: Phi_eff = phi_grav + phi_centrifugal
    float jacobi_potential = -(phi_grav + phi_centrifugal) * 2.0f;

    uint flat_idx = id.x + id.y * _GridDimensions.x + id.z * _GridDimensions.x * _GridDimensions.y;
    _PotentialGrid[flat_idx] = jacobi_potential;
}
