// WSBBundleEvaluator.compute - Weak Stability Boundary Monte Carlo Trajectory Bundle Pipeline
// Advances 4,096 covariance-perturbed particles to evaluate capture stability and confidence tubes.

#pragma kernel EvaluateWSBBundle

#define GROUP_SIZE 128
#define TOTAL_PARTICLES 4096

struct WSBParticleState {
    float3 position;
    float capture_status; // 1.0 = captured, 0.5 = uncertain, 0.0 = escaped
    float3 velocity;
    float min_periapsis;
};

struct CelestialBodyLite {
    float3 position;
    float gm;
};

cbuffer WSBConfig : register(b0) {
    float4 _BasePosition;
    float4 _BaseVelocity;
    float4 _PerturbationSigma; // xyz: position/velocity std dev, w: dt
    uint _StepCount;
    uint _CelestialCount;
    uint _TargetPrimaryIndex;
    uint _TargetSecondaryIndex;
    float _EscapeRadius;
    float _CaptureRadius;
    float2 _WSBPadding;
};

StructuredBuffer<CelestialBodyLite> _CelestialBodies : register(t0);
RWStructuredBuffer<WSBParticleState> _Particles : register(u0);

// Simple pseudo-random hash generator
float Hash11(uint n) {
    n = (n << 13U) ^ n;
    n = n * (n * n * 15731U + 789221U) + 1376312589U;
    return float(n & 0x7fffffffU) / float(0x7fffffff);
}

[numthreads(GROUP_SIZE, 1, 1)]
void EvaluateWSBBundle(uint3 id : SV_DispatchThreadID) {
    uint index = id.x;
    if (index >= TOTAL_PARTICLES) return;

    // Generate pseudo-Gaussian perturbations via Box-Muller-like transform
    float u1 = Hash11(index * 3 + 1);
    float u2 = Hash11(index * 3 + 2);
    float u3 = Hash11(index * 3 + 3);
    float3 delta_vel = (float3(u1, u2, u3) * 2.0f - 1.0f) * _PerturbationSigma.y;

    float3 pos = _BasePosition.xyz;
    float3 vel = _BaseVelocity.xyz + delta_vel;
    float dt = _PerturbationSigma.w;

    float min_r_target = 1e30f;
    bool escaped = false;

    for (uint step = 0; step < _StepCount; ++step) {
        float3 accel = float3(0, 0, 0);
        for (uint b = 0; b < _CelestialCount; ++b) {
            CelestialBodyLite body = _CelestialBodies[b];
            float3 r = body.position - pos;
            float r2 = dot(r, r) + 1.0f;
            float inv_r = rsqrt(r2);
            accel += r * (body.gm * inv_r * inv_r * inv_r);

            if (b == _TargetSecondaryIndex) {
                float dist = sqrt(r2);
                if (dist < min_r_target) {
                    min_r_target = dist;
                }
            }
        }

        vel += accel * dt;
        pos += vel * dt;

        float escape_r = _EscapeRadius > 0.0f ? _EscapeRadius : 1e12f;
        if (length(pos) > escape_r) {
            escaped = true;
            break;
        }
    }

    float capture_r = _CaptureRadius > 0.0f ? _CaptureRadius : 1e8f;
    WSBParticleState result;
    result.position = pos;
    result.velocity = vel;
    result.min_periapsis = min_r_target;
    result.capture_status = escaped ? 0.0f : (min_r_target < capture_r ? 1.0f : 0.5f);

    _Particles[index] = result;
}
