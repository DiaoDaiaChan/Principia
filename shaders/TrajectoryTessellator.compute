#pragma kernel TessellateTrajectoryScreenAdaptive
#pragma kernel EvaluateChebyshevSegmentClenshaw

#define GROUP_SIZE 128
#define MAX_CHEBYSHEV_DEGREE 16

struct TrajectoryNode {
    float3 position_scaled;
    float time;
};

struct ChebyshevSegmentData {
    float t_min;
    float t_max;
    uint degree;
    float padding;
    float3 coeffs[MAX_CHEBYSHEV_DEGREE + 1];
};

struct OutputVertex {
    float3 position;
    float4 color;
};

cbuffer TessellationConfig : register(b0) {
    float4x4 _WorldToCameraMatrix;
    float4x4 _CameraToScreenMatrix;
    float4 _BaseColor;
    float4 _FadeColor;
    uint _NodeCount;
    float _CurvatureTolerancePixels;
    float _CameraDistanceFactor;
    uint _MaxOutputVertices;
};

StructuredBuffer<TrajectoryNode> _InputNodes : register(t0);
RWStructuredBuffer<OutputVertex> _OutputVertices : register(u0);
RWStructuredBuffer<uint> _IndirectArgs : register(u1); // [vertex_count, instance_count, start_vertex, start_instance]

[numthreads(GROUP_SIZE, 1, 1)]
void TessellateTrajectoryScreenAdaptive(uint3 id : SV_DispatchThreadID) {
    uint index = id.x;
    if (index >= _NodeCount - 1) return;

    TrajectoryNode n0 = _InputNodes[index];
    TrajectoryNode n1 = _InputNodes[index + 1];

    // Project points to screen coordinates
    float4 clip0 = mul(_CameraToScreenMatrix, mul(_WorldToCameraMatrix, float4(n0.position_scaled, 1.0f)));
    float4 clip1 = mul(_CameraToScreenMatrix, mul(_WorldToCameraMatrix, float4(n1.position_scaled, 1.0f)));

    // Atomic allocate output vertices
    uint out_idx;
    InterlockedAdd(_IndirectArgs[0], 2, out_idx);

    if (out_idx + 1 < _MaxOutputVertices) {
        float t0 = float(index) / float(_NodeCount);
        float t1 = float(index + 1) / float(_NodeCount);

        OutputVertex v0;
        v0.position = n0.position_scaled;
        v0.color = lerp(_BaseColor, _FadeColor, t0);

        OutputVertex v1;
        v1.position = n1.position_scaled;
        v1.color = lerp(_BaseColor, _FadeColor, t1);

        _OutputVertices[out_idx] = v0;
        _OutputVertices[out_idx + 1] = v1;
    }
}

StructuredBuffer<ChebyshevSegmentData> _ChebyshevSegments : register(t1);

// Kernel 2: Dense Clenshaw evaluation of continuous Chebyshev segments
[numthreads(GROUP_SIZE, 1, 1)]
void EvaluateChebyshevSegmentClenshaw(uint3 id : SV_DispatchThreadID) {
    uint sample_idx = id.x;
    if (sample_idx >= _MaxOutputVertices) return;

    // Evaluate segment at normalized parameter tau in [-1, 1]
    uint seg_idx = sample_idx / 32; // 32 samples per segment
    uint in_seg_sample = sample_idx % 32;
    float tau = lerp(-1.0f, 1.0f, (float)in_seg_sample / 31.0f);

    ChebyshevSegmentData seg = _ChebyshevSegments[seg_idx];
    uint n = min(seg.degree, (uint)MAX_CHEBYSHEV_DEGREE);

    // Clenshaw recurrence: b_k = 2 * tau * b_{k+1} - b_{k+2} + c_k
    float3 b_k1 = float3(0, 0, 0);
    float3 b_k2 = float3(0, 0, 0);
    float two_tau = 2.0f * tau;

    for (int k = n; k >= 1; --k) {
        float3 b_k = two_tau * b_k1 - b_k2 + seg.coeffs[k];
        b_k2 = b_k1;
        b_k1 = b_k;
    }

    float3 pos = tau * b_k1 - b_k2 + seg.coeffs[0];

    OutputVertex v;
    v.position = pos;
    v.color = _BaseColor;
    _OutputVertices[sample_idx] = v;
}
